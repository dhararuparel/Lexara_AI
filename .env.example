GEMINI_API_KEY=your_gemini_api_key_here
SECRET_KEY=your-secret-key-here

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# PostgreSQL — use Supabase connection string for production
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/lexara

# Email (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@lexara.ai

# Cloudinary — set USE_CLOUDINARY=true in production
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting & Security Settings
RATE_LIMIT_ENABLED=true
AUTH_IP_MAX_ATTEMPTS=5
AUTH_ACCOUNT_MAX_ATTEMPTS=5
AUTH_WINDOW_SECS=300
AUTH_BACKOFF_BASE_SECS=5
AUTH_BACKOFF_FACTOR=2
AUTH_BACKOFF_MAX_SECS=3600
PUBLIC_LIMIT_MAX=30
PUBLIC_LIMIT_WINDOW_SECS=60
USER_LIMIT_MAX=120
USER_LIMIT_WINDOW_SECS=60
